# Real per-host values that shouldn't be published (see src/ansible/group_vars/all/00-defaults.yml)
src/ansible/group_vars/all/01-local.yml

# Real per-host values for incus-compose (SSH public key, etc.) - see src/incus-compose/.env.example
src/incus-compose/.env

# OpenTofu local state, secrets, and working directories
src/opentofu/.terraform/
src/opentofu/.terraform.lock.hcl
src/opentofu/terraform.tfstate
src/opentofu/terraform.tfstate.backup
src/opentofu/terraform.tfvars

# OpenTofu also writes timestamped state backups (terraform.tfstate.<epoch>.backup)
# which the two patterns above do NOT match — one of these was committed by
# accident and had to be removed. Glob covers every variant.
src/opentofu/*.tfstate
src/opentofu/*.tfstate.*
src/opentofu/*.tfbackup
