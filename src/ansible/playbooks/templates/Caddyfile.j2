# Managed by Ansible (src/ansible/playbooks/headscale.yml and
# src/ansible/playbooks/headplane.yml). Manual edits will be overwritten on
# the next playbook run.
#
# Caddy terminates TLS for {{ headscale_domain }}, obtaining and renewing
# its Let's Encrypt certificate automatically (ACME HTTP-01 challenge on
# port 80, both ports forwarded on the router — see references/INSTALL.md).
# Everything under /admin/* is headplane's web UI; everything else
# reverse-proxies to headscale's own plain-HTTP API listener. Uses `handle`
# (not `handle_path`) so the /admin prefix reaches headplane intact, since
# headplane's own routing expects to still see it.
{{ headscale_domain }} {
    handle /admin/* {
        reverse_proxy 127.0.0.1:{{ headplane_port }}
    }

    handle {
        reverse_proxy 127.0.0.1:8080
    }
}
